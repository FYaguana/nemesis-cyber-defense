# Copie este archivo como ".env" (en la misma carpeta que docker-compose.yml) y complete los valores.
# El archivo ".env" NO se sube a git (está en .gitignore). ".env.example" sí, porque no contiene secretos.
#
#   PowerShell:   copy .env.example .env
#                 notepad .env

# Correo del primer Administrador. Al arrancar, el enlace de activación aparece en los logs del backend.
NEMESIS_ADMIN_EMAIL=

# Cuenta de Gmail que envía las invitaciones y una CONTRASEÑA DE APLICACIÓN (no la contraseña normal).
# Se crea en https://myaccount.google.com/apppasswords (requiere la verificación en dos pasos).
NEMESIS_GMAIL_USER=
NEMESIS_GMAIL_APP_PASSWORD=

# Clave de la API de Gemini (opcional; también se puede cargar desde la pantalla del Administrador).
GEMINI_API_KEY=
