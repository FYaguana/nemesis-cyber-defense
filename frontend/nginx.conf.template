server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Reverse proxy: todo lo que pega a /api/* se reenvía al backend real
    # (NEMESIS_API_URL). Así el navegador solo ve UN dominio (el del
    # frontend), sin necesidad de CORS ni de cookies cross-site
    # (SameSite=None). ${NEMESIS_API_URL} se reemplaza en el arranque del
    # contenedor por docker-entrypoint-nemesis.sh usando envsubst.
    location /api/ {
        proxy_pass ${NEMESIS_API_URL}/api/;
        # Sin esto, nginx NO manda el SNI al conectar por HTTPS al backend.
        # Render usa el SNI para enrutar al servicio correcto y elegir el
        # certificado -- sin él, el handshake TLS falla directamente
        # (visible en logs como "SSL_do_handshake() failed ... alert
        # number 40: handshake_failure").
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        # El Host debe ser el del BACKEND real (no el del frontend), porque
        # Render también puede usar el header Host -- además del SNI -- para
        # decidir a qué servicio dirigir la petición.
        proxy_set_header Host ${NEMESIS_API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Reescribe el "path" de las cookies que pone el backend para que
        # sigan siendo válidas bajo el dominio del frontend.
        proxy_cookie_path / /;
    }

    # Cada página HTML se sirve tal cual (login, dashboard, activar, etc.)
    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}
